# Bu dosyayı ".env" olarak kopyalayıp gerçek değerlerinizi girin.
# .env dosyasını ASLA git'e commit etmeyin (.gitignore'a ekleyin).

# --- Portföy ---
TOPLAM_EUR=30000
EUR_FAIZ=0.025
TL_FAIZ_VARSAYILAN=0.40
TL_STOPAJ=0.15
# Bireysel TL vadeli mevduat stopajı (2024+ GVK Md.94) — tüm vadeler %15
TL_STOPAJ_ORAN=0.15
KALAN_GUN=153

# --- API anahtarları ---
# FRED (ABD Fed faizi) - ücretsiz kayıt: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# TCMB EVDS — ÜCRETSİZ kayıt (kişisel/kurumsal):
# 1) https://evds3.tcmb.gov.tr adresine git → Kayıt ol / Giriş yap
# 2) Profilim → "API Key Kopyala"
# 3) Aşağıya yapıştır → terminalde: python main.py --evds-test
EVDS_API_KEY=

# Telegram bildirimi (isteğe bağlı) - kurulum için notifier.py başındaki yorumlara bakın
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bildirim kanalı: telegram | whatsapp | both
BILDIRIM_KANALI=telegram

# WhatsApp — CallMeBot (kişisel): https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# WhatsApp Cloud API (alternatif — Meta iş hesabı)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=

# Sinyal alarmı profili ve DİKKAT bildirimi
INVESTOR_RISK=orta
INVESTOR_VADE=orta
NOTIFY_SINIRLI=false

# --- CDS (Türkiye 5Y) — Bloomberg Terminal + Investing.com otomatik ---
# Bloomberg Terminal açıkken BLPAPI ile çekilir; yoksa Investing.com.
# Kurulum: pip install blpapi  (Bloomberg aboneliği gerekir)
BLOOMBERG_CDS_TICKER=TRGV5YUSAC Corp
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194
# BLOOMBERG_CDS_KAPALI=1
CDS_CAPRAZ_ESIGI=0.10
CDS_SICRAMA_ESIGI=0.10
CDS_BILDIRIM_ESIGI=0.05
CDS_OTO_REFERANS_YAZ=1
DEFAULT_CDS_BP=265

SIYASI_RISK_TABAN=52
SIYASI_RISK_TEMKIN=70
SIYASI_RISK_KRIZ=85
SIYASI_RISK_TABAN_GUN=14
SIYASI_RISK_SAAT=48
